# =============================================================================
# CS2Archive — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# FACEIT Data API Key (free, get from https://developers.faceit.com/)
FACEIT_API_KEY=your_data_api_key_here

# FACEIT Downloads API Token (requires separate application at https://fce.gg/downloads-api-application)
# Same token as the original API application, with the download scope added.
FACEIT_DOWNLOADS_TOKEN=

# YouTube Data API v3 Key (free, get from https://console.cloud.google.com/apis/credentials)
# Used by `trending` command to find most-watched CS2 match
YOUTUBE_API_KEY=

# Optional: Override demo storage directory (default: ./demos)
# DEMO_STORAGE_DIR=./demos
