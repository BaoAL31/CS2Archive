+// Called only from engine-thread callbacks / console commands.
+bool EnsureFrameHook()
+{
+    if (originalFrameStageNotify != NULL) return true;
+    if (factory == NULL) return false;
+    auto availableClient = (ISource2Client*)factory("Source2Client002", NULL);
+    auto engine = GetEngine();
+    if (availableClient == NULL || engine == NULL) return false;
+
+    // Set UI mode synchronously before a subsequent startup playdemo command.
+    engine->ExecuteClientCmd(0, "demo_ui_mode 0", true);
+    engine->ExecuteClientCmd(0, "sv_cheats 1", true);
+    client = availableClient;
+    auto vtable = *(void***)client;
+    originalFrameStageNotify = (FrameStageNotifyFn)vtable[36];
+    PatchVTableEntry(vtable, 36, (void*)&NewFrameStageNotify);
+    Log("Hooked FrameStageNotify");
+    return true;
+}
